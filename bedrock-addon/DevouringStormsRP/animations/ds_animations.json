{
  "format_version": "1.10.0",
  "animations": {
    "animation.ds.massg": {
      "loop": true,
      "bones": {
        "core": { "rotation": { "x": 0, "y": "query.anim_time * 40", "z": 0 }, "position": { "x": 0, "y": "math.sin(query.anim_time * 30)", "z": 0 } },
        "maw": { "position": { "x": 0, "y": "math.abs(math.sin(query.anim_time * 15)) * 3 - 4", "z": 0 } },
        "head_front": { "rotation": { "x": 0, "y": "math.sin(query.anim_time * 10) * 20", "z": 0 } },
        "head_left": { "rotation": { "x": 0, "y": "34 + math.sin(query.anim_time * 8 + 2) * 17", "z": 0 } },
        "head_right": { "rotation": { "x": 0, "y": "-34 + math.cos(query.anim_time * 7) * 17", "z": 0 } },
        "tentacle0": { "rotation": { "x": "math.sin(query.anim_time * 22 + 0) * 15 + 8", "y": 0, "z": "math.cos(query.anim_time * 17 + 1) * 12" } },
        "tentacle1": { "rotation": { "x": "math.sin(query.anim_time * 22 + 1.3) * 15 + 8", "y": 0, "z": "math.cos(query.anim_time * 17 + 2) * 12" } },
        "tentacle2": { "rotation": { "x": "math.sin(query.anim_time * 22 + 2.6) * 15 + 8", "y": 0, "z": "math.cos(query.anim_time * 17 + 3) * 12" } },
        "tentacle3": { "rotation": { "x": "math.sin(query.anim_time * 22 + 3.9) * 15 + 8", "y": 0, "z": "math.cos(query.anim_time * 17 + 4) * 12" } },
        "tentacle4": { "rotation": { "x": "math.sin(query.anim_time * 22 + 5.2) * 15 + 8", "y": 0, "z": "math.cos(query.anim_time * 17 + 5) * 12" } },
        "tentacle5": { "rotation": { "x": "math.sin(query.anim_time * 22 + 6.5) * 15 + 8", "y": 0, "z": "math.cos(query.anim_time * 17 + 6) * 12" } }
      }
    },

    "animation.ds.watcher": {
      "loop": true,
      "bones": {
        "torso": { "rotation": { "x": "5 + math.sin(query.anim_time * 6) * 2", "y": 0, "z": 0 } },
        "head": { "rotation": { "x": "math.sin(query.anim_time * 9) * 4", "y": 0, "z": 0 } },
        "gaze": { "position": { "x": 0, "y": "math.sin(query.anim_time * 210) > 60 ? 0 : -0.2", "z": 0 } },
        "arm_left": { "rotation": { "x": 0, "y": 0, "z": "math.sin(query.anim_time * 7) * 2" } },
        "arm_right": { "rotation": { "x": 0, "y": 0, "z": "math.sin(query.anim_time * 7 + 1) * -2" } }
      }
    },

    "animation.ds.tazo": {
      "loop": true,
      "animation_length": 1.0,
      "bones": {
        "leg_left": { "rotation": { "x": "math.sin(query.anim_time * 220) * 35 * query.modified_move_speed", "y": 0, "z": 0 } },
        "leg_right": { "rotation": { "x": "math.sin(query.anim_time * 220 + 180) * 35 * query.modified_move_speed", "y": 0, "z": 0 } },
        "arm_left": { "rotation": { "x": "math.sin(query.anim_time * 220 + 180) * 25 * query.modified_move_speed", "y": 0, "z": 0 } },
        "arm_right": { "rotation": { "x": "math.sin(query.anim_time * 220) * 25 * query.modified_move_speed", "y": 0, "z": 0 } },
        "head": { "rotation": { "x": "math.sin(query.anim_time * 9) * 3", "y": 0, "z": 0 } }
      }
    },

    "animation.ds.anna": {
      "loop": true,
      "bones": {
        "head": { "rotation": { "x": 0, "y": "math.sin(query.anim_time * 20) * 10", "z": 0 } },
        "dress": { "position": { "x": "math.sin(query.anim_time * 13) > 60 ? 1 : 0", "y": 0, "z": 0 } }
      }
    },

    "animation.ds.severed": {
      "loop": true,
      "bones": {
        "knot": { "rotation": { "x": 0, "y": "query.anim_time * 160", "z": 0 } },
        "spine_0": { "rotation": { "x": "20 + math.sin(query.anim_time * 60) * 20", "y": 0, "z": 20 } },
        "spine_1": { "rotation": { "x": "-15 + math.cos(query.anim_time * 50) * 18", "y": 0, "z": -25 } },
        "spine_2": { "rotation": { "x": "25 + math.sin(query.anim_time * 55 + 1) * 20", "y": 0, "z": -10 } }
      }
    },

    "animation.ds.watcher_blink": {
      "loop": true,
      "bones": {
        "gaze": { "scale": { "x": 1, "y": "math.sin(query.anim_time * 40) > 55 ? 0.2 : 1.0", "z": 1 } }
      }
    },

    "animation.ds.symbiont": {
      "loop": true,
      "animation_length": 1.0,
      "bones": {
        "leg_left": { "rotation": { "x": "math.sin(query.anim_time * 260) * 30 * query.modified_move_speed", "y": 0, "z": 0 } },
        "leg_right": { "rotation": { "x": "math.sin(query.anim_time * 260 + 180) * 30 * query.modified_move_speed", "y": 0, "z": 0 } },
        "arm_left": { "rotation": { "x": "-60 + math.sin(query.anim_time * 260 + 180) * 20 * query.modified_move_speed", "y": 0, "z": -9 } },
        "arm_right": { "rotation": { "x": "-58 + math.sin(query.anim_time * 260) * 20 * query.modified_move_speed", "y": 0, "z": 11 } },
        "head": { "rotation": { "x": 0, "y": 0, "z": "math.sin(query.anim_time * 16) * 5" } }
      }
    },

    "animation.ds.storm_skull": {
      "loop": true,
      "bones": {
        "skull": { "rotation": { "x": "query.anim_time * 120", "y": "query.anim_time * 200", "z": 0 } }
      }
    }
  }
}
