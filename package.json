{
  "name": "unlimited-possibilities-sandbox",
  "version": "1.0.0",
  "description": "A universe where the player controls the simulation itself",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "check:shaders": "node tools/shader-check.mjs",
    "check:physics": "node tools/physics-check.mjs",
    "check:ui": "node tools/ui-check.mjs",
    "check": "tsc --noEmit && npm run check:shaders && npm run check:physics && npm run check:water && npm run check:history && npm run check:ui && npm run check:boot",
    "check:boot": "node tools/boot-check.mjs",
    "check:history": "node tools/history-check.mjs",
    "check:water": "node tools/water-check.mjs"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.20.1"
  }
}
