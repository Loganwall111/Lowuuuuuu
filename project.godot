; AEON — Evolution Simulator
; Godot 4 project configuration.
; Engine target: Godot 4.4 or newer (Forward+ renderer).
;
; NOTE: Input actions are also re-asserted at runtime by SettingsService so the
; build still functions if this file is ever regenerated by the editor.

config_version=5

[application]

config/name="AEON — Evolution Simulator"
config/description="A cinematic 3D evolution simulator: microscopic life to spacefaring civilisation."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.03, 0.05, 1)

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
SettingsService="*res://scripts/core/settings_service.gd"
PoolService="*res://scripts/core/pool_service.gd"
SimulationDirector="*res://scripts/core/simulation_director.gd"
AudioDirector="*res://scripts/core/audio_director.gd"
SceneDirector="*res://scripts/core/scene_director.gd"
SaveService="*res://scripts/core/save_service.gd"
GameDirector="*res://scripts/core/game_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

