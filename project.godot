[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Creature"
3d_physics/layer_4="Edible"
3d_physics/layer_5="PlayerSensor"
3d_physics/layer_6="WaterVolume"
3d_physics/layer_7="GravityField"
3d_physics/layer_8="Debris"
3d_physics/layer_9="Trigger"
3d_physics/layer_10="Projectile"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8
3d/default_linear_damp=0.1
3d/default_angular_damp=0.4

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/defaults/default_environment="res://resources/environments/default_environment.tres"
